{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node"
        ],
        "noEmit": true
    },
    "include": [
        "src",
        "tests"
    ]
}